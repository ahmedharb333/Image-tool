---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GUIDES } from '../content/guides';
import { TOOLS } from '../config/tools';
import { UI } from '../config/ui';
import { type Locale } from '../config/site';
import { localizedPath, tr } from '../lib/i18n';
import { breadcrumbJsonLd } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = localizedPath(locale, '/guides/');
const title = tr(UI.sectionGuides, locale);
const schema = [
  breadcrumbJsonLd([
    { name: tr(UI.crumbHome, locale), path: localizedPath(locale, '/') },
    { name: title, path },
  ]),
];
---

<BaseLayout title={title} description={tr(UI.guidesIndexMetaDesc, locale)} path={path} schemaJsonLd={schema} locale={locale}>
  <div class="container">
    <header class="page-header">
      <h1>{title}</h1>
      <p>{tr(UI.guidesIndexDesc, locale)}</p>
    </header>
    <div class="card-grid">
      {
        GUIDES.map((g) => {
          const tool = TOOLS.find((t) => t.slug === g.slug);
          return (
            <article class="card">
              <h2><a href={localizedPath(locale, `/guides/${g.slug}/`)}>{tr(g.title, locale)}</a></h2>
              <p>{tr(g.description, locale)}</p>
              {tool && <a class="btn btn--sm btn--accent" href={localizedPath(locale, `/tools/${g.slug}/`)}>{tr(UI.tryTheTool, locale)}</a>}
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
