---
import Head from '../components/Head.astro';
import AdSlot from '../components/AdSlot.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import ConsentToggle from '../components/ConsentToggle.astro';
import { NAV } from '../config/nav';
import { LOGO, SITE, type Locale } from '../config/site';
import { UI } from '../config/ui';
import { DIR, LANG_ATTR, localizedPath, navHref, switchLocalePath, tr } from '../lib/i18n';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/tool-area.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schemaJsonLd?: object[];
  lastReviewed?: string;
  isHome?: boolean;
  locale?: Locale;
}

const {
  title,
  description,
  path,
  ogType,
  noindex,
  schemaJsonLd,
  lastReviewed,
  isHome = false,
  locale = 'ar',
} = Astro.props;

const currentPath = Astro.url.pathname;
const active = (href: string) => (currentPath === href ? 'page' : undefined);
const otherLocale: Locale = locale === 'ar' ? 'en' : 'ar';
const otherLocalePath = switchLocalePath(otherLocale, currentPath);
const otherLocaleLabel = otherLocale === 'en' ? UI.switchToEnglish : UI.switchToArabic;
const home = localizedPath(locale, '/');
---

<!doctype html>
<html dir={DIR[locale]} lang={LANG_ATTR[locale]} data-theme="light">
  <head>
    <Head
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      noindex={noindex}
      schemaJsonLd={schemaJsonLd}
      lastReviewed={lastReviewed}
      locale={locale}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{tr(UI.skipToContent, locale)}</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-logo" href={home} aria-label={tr(LOGO.text, locale)}>{tr(LOGO.text, locale)}</a>
        <nav class="site-nav" aria-label={tr(UI.mainNavAria, locale)}>
          <ul>
            {
              NAV.main.map((item) => (
                <li>
                  <a href={navHref(locale, item.href)} aria-current={active(navHref(locale, item.href))}>{tr(item.label, locale)}</a>
                </li>
              ))
            }
            <li>
              <a class="lang-switch" href={otherLocalePath} aria-label={tr(UI.langSwitchAria, locale)}>{tr(otherLocaleLabel, locale)}</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div>
            <h2>{tr(LOGO.lockup, locale)}</h2>
            <p>{tr(SITE.tagline, locale)}</p>
          </div>
          <div>
            <h2>{tr(UI.footerQuickLinks, locale)}</h2>
            <ul>
              {
                NAV.main.map((item) => (
                  <li><a href={navHref(locale, item.href)}>{tr(item.label, locale)}</a></li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2>{tr(UI.footerLegal, locale)}</h2>
            <ul>
              {
                NAV.footer.map((item) => (
                  <li><a href={navHref(locale, item.href)}>{tr(item.label, locale)}</a></li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p>
            © {new Date().getFullYear()} {tr(SITE.brandName, locale)} — {tr(UI.rightsReserved, locale)}
          </p>
          <div class="site-footer__consent">
            <ConsentToggle />
            <span>{tr(UI.consentToggleLabel, locale)}</span>
          </div>
          <AdSlot location="sidebar" />
        </div>
      </div>
    </footer>
    <ConsentBanner />
  </body>
</html>
